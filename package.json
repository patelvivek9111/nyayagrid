{
  "name": "nyayagrid",
  "private": true,
  "version": "0.1.0",
  "description": "NyayaGrid — AI-native legal operating system",
  "workspaces": [
    "apps/*",
    "packages/*",
    "benchmarks/nyaya-bench",
    "benchmarks/performance"
  ],
  "scripts": {
    "dev": "npm run dev -w @nyayagrid/web",
    "dev:worker": "npm run dev -w @nyayagrid/worker",
    "build": "npm run build -w @nyayagrid/web",
    "lint": "npm run lint -w @nyayagrid/web && npm run lint -w @nyayagrid/database && npm run lint -w @nyayagrid/permissions && npm run lint -w @nyayagrid/ai && npm run lint -w @nyayagrid/documents && npm run lint -w @nyayagrid/auth && npm run lint -w @nyayagrid/validation && npm run lint -w @nyayagrid/jobs && npm run lint -w @nyayagrid/observability && npm run lint -w @nyayagrid/ui && npm run lint -w @nyayagrid/search && npm run lint -w @nyayagrid/intelligence && npm run lint -w @nyayagrid/jurisdiction && npm run lint -w @nyayagrid/research && npm run lint -w @nyayagrid/agents && npm run lint -w @nyayagrid/workspaces && npm run lint -w @nyayagrid/platform",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "eval:ai": "npm run eval:ai -w @nyayagrid/ai && npm run eval:ai -w @nyayagrid/intelligence",
    "eval:ai:stress": "npm run eval:ai:stress -w @nyayagrid/ai",
    "eval:ai:live": "node scripts/eval-ai-live.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @nyayagrid/database",
    "db:migrate": "npm run migrate -w @nyayagrid/database",
    "db:studio": "npm run studio -w @nyayagrid/database",
    "research:import": "npm run research:import -w @nyayagrid/research",
    "research:corpus-import": "npm run research:corpus-import -w @nyayagrid/research",
    "corpus:db-identity": "tsx scripts/corpus-db-identity.ts",
    "seed:golden-matter": "npm run seed:golden-matter -w @nyayagrid/documents",
    "bench": "npm run bench -w @nyayagrid/nyaya-bench --",
    "bench:j1": "npm run bench:j1 -w @nyayagrid/nyaya-bench",
    "bench:6t": "npm run bench:6t -w @nyayagrid/nyaya-bench",
    "bench:6t-corpus1": "npm run bench:6t-corpus1 -w @nyayagrid/nyaya-bench",
    "bench:6t-c2a": "npm run bench:6t-c2a -w @nyayagrid/nyaya-bench",
    "bench:6u": "npm run bench:6u -w @nyayagrid/nyaya-bench",
    "bench:6u-r1": "npm run bench:6u-r1 -w @nyayagrid/nyaya-bench",
    "bench:6v": "npm run bench:6v -w @nyayagrid/nyaya-bench",
    "bench:fw1": "npm run bench:fw1 -w @nyayagrid/nyaya-bench --",
    "perf:baseline": "npm run perf:offline -w @nyayagrid/perf-baseline",
    "perf:baseline:p2": "npm run perf:p2 -w @nyayagrid/perf-baseline",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "ops:backup-rehearse": "node scripts/rehearse-backup-restore.mjs",
    "ops:verify-clamav": "node scripts/verify-clamav.mjs",
    "ops:6w": "tsx scripts/phase-6w-ops.ts",
    "ops:6w-frozen": "tsx scripts/frozen-regression-harness.ts",
    "ops:6w-frozen-unit": "tsx scripts/frozen-regression-harness.ts --unit-only",
    "beta:check": "tsx scripts/beta-check.ts",
    "beta:stuck-documents": "tsx scripts/stuck-documents.ts",
    "beta:smoke": "tsx scripts/beta-smoke.ts",
    "beta:canary": "tsx scripts/beta-smoke.ts --canary"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    },
    "drizzle-kit": {
      "esbuild": "0.25.12",
      "@esbuild-kit/core-utils": {
        "esbuild": "0.25.12"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
