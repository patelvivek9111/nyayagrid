# Controlled-beta production profile — placeholders only. Copy to a secret store.
# Do not commit filled values.

APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.example.com

AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

DATABASE_URL=

RATE_LIMIT_PROVIDER=redis
REDIS_URL=

STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# If using self-hosted MinIO instead of S3, set STORAGE_PROVIDER=minio and
# ALLOW_MINIO_IN_PRODUCTION=1 with unique non-compose credentials and a private endpoint.
# ALLOW_MINIO_IN_PRODUCTION=0

MALWARE_SCANNER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

AI_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Optional capability overrides — leave unset to use platform defaults.
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MODEL_QA=
# MODEL_EXTRACTION=
# MODEL_EMBEDDING=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DISABLED must stay unset. Async ingest requires Inngest.

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

BILLING_PROVIDER=database
OCR_PROVIDER=none
RESEARCH_PROVIDER=local

FEATURE_PROFESSOR=0
FEATURE_AGENTS=0
FEATURE_GUIDE=0
FEATURE_RESEARCH=1
FEATURE_OCR=0
FEATURE_LIVE_AI=0
# ALLOW_AUTHORITY_HTTP_IMPORT must stay unset.

LOG_LEVEL=info
