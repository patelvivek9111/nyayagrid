# NyayaGrid local development environment
# Copy to .env and adjust as needed. Do not commit secrets.

NODE_ENV=development

# Deployment environment: "development", "test", "staging", or "production". This is the single
# source of truth for every production-safety decision in @nyayagrid/platform's configuration gate
# (see packages/platform/src/config.ts) — NODE_ENV=production alone is NOT treated as an intent
# declaration, so a real deployment must set APP_ENV=production explicitly or it is refused at
# startup (apps/web/src/instrumentation.ts calls validateConfigForEnv, which throws).
APP_ENV=development

# Database (Docker PostgreSQL + pgvector)
DATABASE_URL=postgresql://nyayagrid:nyayagrid@localhost:5433/nyayagrid

# Auth provider: "dev" (local free) or "clerk" (Clerk free-tier when configured). AUTH_PROVIDER=dev
# accepts an identity from the x-nyayagrid-dev-user request header and is a production blocker.
AUTH_PROVIDER=dev
# Dev auth only — never use in production
DEV_AUTH_USER_ID=dev_user_owner
DEV_AUTH_EMAIL=owner@example.nyayagrid.local
DEV_AUTH_NAME=Dev Owner

# Clerk (optional — free tier). Required only when AUTH_PROVIDER=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Object storage (MinIO locally; S3-compatible later)
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nyayagrid
S3_SECRET_ACCESS_KEY=nyayagridsecret
S3_BUCKET=nyayagrid-documents
S3_FORCE_PATH_STYLE=true
# STORAGE_PROVIDER=minio is a production blocker unless the operator explicitly opts in to
# self-hosting it (encryption/versioning/backup become the operator's responsibility either way).
# ALLOW_MINIO_IN_PRODUCTION=1

# AI
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Per-capability model overrides (optional). Each resolves MODEL_<CAPABILITY> -> OPENAI_MODEL /
# OPENAI_EMBEDDING_MODEL -> an environment default; see packages/platform/src/models.ts.
# MODEL_QA=
# MODEL_EXTRACTION=
# MODEL_DRAFT=
# MODEL_RESEARCH=
# MODEL_AGENTS=
# MODEL_PROFESSOR=
# MODEL_GUIDE=
# MODEL_EMBEDDING=

# Malware scanning: "development" (never marks clean; local/dev only, a production blocker) or
# "clamav" (requires CLAMAV_HOST or CLAMAV_FIXTURE for local testing without a real clamd).
MALWARE_SCANNER=development
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Use ClamAV's fixture heuristics (EICAR string / "infected" in storage key) instead of a real
# clamd connection — for local dev and tests only.
# CLAMAV_FIXTURE=1

# OCR: "none" (default; image-only PDFs stay in requires_ocr rather than being silently treated as
# empty) is the only implemented provider today — any other value is a production blocker because
# no adapter exists yet. Set OCR_ENDPOINT to POST file bytes to an external OCR HTTP service once
# one is wired in.
OCR_PROVIDER=none
# OCR_ENDPOINT=
# OCR_API_KEY=
# OCR_TIMEOUT_MS=60000

# Upload / processing limits (all optional; sane defaults apply)
# MAX_EXTRACTED_CHARS=2000000
# MAX_PAGES=2000
# MALWARE_SCAN_TIMEOUT_MS=30000
# EXTRACTION_TIMEOUT_MS=60000

# Legal research (Phase 6). "local" = corpus already imported into this database only, no
# paid third-party legal research API is called.
RESEARCH_PROVIDER=local

# Jobs (Inngest local)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_DEV=1

# Nyaya agents (Phase 7). Optional execution budgets for orchestrated agent runs; unset values
# fall back to the defaults in @nyayagrid/agents (maxSteps=12, maxToolCalls=40, timeoutMs=120000).
# AGENT_MAX_STEPS=12
# AGENT_MAX_TOOL_CALLS=40
# AGENT_TIMEOUT_MS=120000

# Feature flags (Phase 9). Never an authorization decision — see packages/platform/src/features.ts.
# Unset uses the environment default (everything but ocr/live_ai is on in development/test, and
# everything is off in staging/production until explicitly enabled).
# FEATURE_AGENTS=1
# FEATURE_PROFESSOR=1
# FEATURE_GUIDE=1
# FEATURE_RESEARCH=1
# FEATURE_OCR=0
# FEATURE_LIVE_AI=0

# Email (Phase 9 — organization invites and notifications). "console" logs the message (including
# the invite link/token) to the process log instead of delivering it and is a production blocker;
# set EMAIL_PROVIDER=smtp with the SMTP_* vars below for a real deployment.
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# EMAIL_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURE=1

# Billing (Phase 9). "development" grants every entitlement and is a production blocker; set
# BILLING_PROVIDER=database to read real organization_subscriptions rows.
BILLING_PROVIDER=development

# Rate limiting (Phase 9). "memory" counts per process (see
# packages/platform/src/rate-limit.ts's InMemoryRateLimiter) and does not hold a limit across
# horizontally scaled instances — it is a production blocker; configure a shared store
# (e.g. Redis-backed) before a multi-instance deployment. Presets (requests per window, and
# whether counted per user/organization/IP) are fixed in RATE_LIMIT_PRESETS, not env-configurable.
RATE_LIMIT_PROVIDER=memory

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
