# Staging-shaped environment — copy to `.env.staging` (do not commit secrets).
# APP_ENV=staging logs every production blocker as a warning and still boots.
# AUTH_PROVIDER=dev cannot authenticate here even if the process starts: DevAuthProvider
# returns no identity on staging/production. Use Clerk keys for a real staging deploy.

APP_ENV=staging
NODE_ENV=production

DATABASE_URL=postgresql://nyayagrid:nyayagrid@localhost:5433/nyayagrid

AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

STORAGE_PROVIDER=minio
ALLOW_MINIO_IN_PRODUCTION=1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=nyayagrid
S3_SECRET_ACCESS_KEY=nyayagridsecret
S3_BUCKET=nyayagrid-documents
S3_FORCE_PATH_STYLE=true

AI_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai

MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

OCR_PROVIDER=none
RESEARCH_PROVIDER=local

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=

BILLING_PROVIDER=database
RATE_LIMIT_PROVIDER=redis
REDIS_URL=redis://127.0.0.1:6379

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=0

# Staging/production feature flags default off until explicitly enabled.
# FEATURE_AGENTS=1
# FEATURE_PROFESSOR=1
# FEATURE_GUIDE=1
# FEATURE_RESEARCH=1

NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
