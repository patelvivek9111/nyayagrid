{
  "name": "@nyayagrid/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./evals": "./src/evals/index.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:ai": "tsx src/evals/run.ts",
    "eval:ai:live": "tsx src/evals/run.ts --live",
    "eval:ai:stress": "tsx src/evals/run.ts --stress"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
