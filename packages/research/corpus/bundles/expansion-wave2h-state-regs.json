    "bundlePracticeAreas": ["employment", "regulation"],
    "content": "Minn. R. 5200.0120\n\nSubpart 1. Overtime rate. An employer shall pay an employee for overtime work at a rate of at least one and one-half times the employee's regular rate of pay as provided by Minnesota Statutes, section 177.25.",
    "sections": [{ "sectionRef": "5200.0120", "content": "Minnesota requires overtime at least one and one-half times the regular rate for covered overtime work." }],
