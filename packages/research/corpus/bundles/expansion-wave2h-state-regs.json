    "bundlePracticeAreas": ["employment", "regulation"],
    "content": "Wis. Admin. Code DWD § 274.03\n\n(1) Except as provided in s. DWD 274.04, each employer shall pay an employee for overtime at a rate of not less than one and one-half times the employee's regular rate of pay for all hours worked in excess of 40 hours per week.",
    "sections": [{ "sectionRef": "274.03", "content": "Wisconsin generally requires overtime at one and one-half times the regular rate after 40 hours." }],
