  "certificationOverlay": "nyaya-four-provider-cert-v1",
  "certificationRulesVersion": "nyaya-cert-rules-v1",
  "promptVersionAsk": "nyaya-matter-qa-v11",
  "fallbackPolicy": {
    "eligible": "VALIDATED_or_ACTIVE_only",
    "ask": "none",
    "research": "none",
    "draft": "none",
    "deposition": "none",
    "contract": ["xai:grok-3", "openai:gpt-4o-mini"],
    "evidence": ["openai:gpt-4o-mini", "xai:grok-3"],
    "compare": ["openai:gpt-4o-mini", "xai:grok-3"],
    "contradiction": ["xai:grok-3", "google:gemini-3.6-flash"],
    "timeline": ["openai:gpt-4o-mini", "xai:grok-3"],
    "graph": ["openai:gpt-4o-mini", "xai:grok-3"],
    "memory": ["openai:gpt-4o-mini", "xai:grok-3"]
