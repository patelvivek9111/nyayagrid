  "killSwitches": {
    "providers": "NYAYA_DISABLED_PROVIDERS",
    "models": "NYAYA_DISABLED_MODELS",
    "deep": "NYAYA_DISABLE_DEEP",
    "dynamic": "per-request-env-object; process.env is startup unless injected"
  },
  "providerPolicy": {
    "unknownAllowList": "denyAll",
    "orgOverlay": "merge-blocked-union-allowed-org-wins-if-set"
  },
  "featureAgents": "OFF",
  "healthState": "NOT_FROZEN"
